  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:mobile-chrome": "playwright test --project=\"Mobile Chrome - Pixel 7\"",
    "test:mobile-safari": "playwright test --project=\"Mobile Safari - iPhone 14\"",
    "report:html": "playwright show-report reports/html-report",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "typecheck": "tsc --noEmit",
    "test:android": "node mobile/scripts/run-with-appium.js",
    "test:android:spec": "node mobile/scripts/run-with-appium.js --spec"
  },
  "repository": {
    "type": "git",
